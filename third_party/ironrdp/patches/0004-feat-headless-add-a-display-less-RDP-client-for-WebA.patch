+//! A display-less RDP client for WebAssembly hosts (WASI).
+//!
+//! The host owns the network: it opens the TCP connection, upgrades it to TLS when asked, and
+//! moves bytes. This module runs IronRDP's connection sequence (CredSSP included) and session,
+//! takes input and display requests from the host, and reports what the server sends as events.
+//! One call to [`run`] drives one session to its end. The module instance keeps the server's
+//! latest auto-reconnect cookie between runs, so a later run can rejoin that session.
+//!
+//! Host imports, from the `tessera` module:
+//!
+//! - `recv(ptr, cap) -> i32` blocks until the host has a message for the session, writes it
+//!   ([`wire::parse_message`]) and returns its length, 0 when the connection is gone, or a
+//!   negative error.
+//! - `send(ptr, len) -> i32` writes bytes to the server, returning 0 or a negative error.
+//! - `upgrade_tls(ptr, cap) -> i32` upgrades the connection to TLS and writes the server's public
+//!   key, which CredSSP binds to, returning its length or a negative error. The host verifies the
+//!   server's certificate.
+//! - `event(kind, ptr, len)` reports an [`Event`].
+//!
+//! Exports: [`alloc`], for the host to place the configuration ([`wire::parse_config`]), and
+//! [`run`].
+
+#![allow(unsafe_code, reason = "the host interface is FFI")]
+
+pub mod wire;
+
+use core::net::{Ipv4Addr, SocketAddr, SocketAddrV4};
+use std::collections::VecDeque;
+use std::io::{self, Read, Write};
+use std::sync::Mutex;
+
+use bytes::{Bytes, BytesMut};
+use ironrdp::connector::connection_activation::{ConnectionActivationFactory, ConnectionActivationState};
+use ironrdp::connector::sspi;
+use ironrdp::connector::sspi::generator::NetworkRequest;
+use ironrdp::connector::sspi::network_client::NetworkClient;
+use ironrdp::connector::{self, ClientConnector, ConnectionOutcome, Credentials, Sequence as _, ServerName};
+use ironrdp::displaycontrol::client::DisplayControlClient;
+use ironrdp::dvc::DrdynvcClient;
+use ironrdp::graphics::image_processing::PixelFormat;
+use ironrdp::input::Database;
+use ironrdp::pdu::PduHint;
+use ironrdp::pdu::geometry::{ExclusiveRectangle, InclusiveRectangle};
+use ironrdp::pdu::rdp::capability_sets::{MajorPlatformType, RailSupportLevel, client_codecs_capabilities};
+use ironrdp::pdu::rdp::client_info::{PerformanceFlags, TimezoneInfo};
+use ironrdp::pdu::rdp::headers::ShareDataPdu;
+use ironrdp::pdu::rdp::session_info::ServerAutoReconnect;
+use ironrdp::pdu::rdp::suppress_output::SuppressOutputPdu;
+use ironrdp::session::image::DecodedImage;
+use ironrdp::session::{ActiveStage, ActiveStageBuilder, ActiveStageOutput};
+use ironrdp_blocking::Framed;
+use ironrdp_core::WriteBuf;
+use ironrdp_egfx::client::{GraphicsPipelineClient, GraphicsPipelineHandler};
+use ironrdp_egfx::decode::{DecodedFrame, DecoderError, DecoderResult, H264Decoder};
+
+use self::wire::{Config, End, Input, Message};
+
+/// The latest auto-reconnect cookie the server issued. Its random bits are credential material, so
+/// it never leaves the module: a run with `rejoin` presents it instead.
+static RECONNECT_COOKIE: Mutex<Option<ServerAutoReconnect>> = Mutex::new(None);
+
+/// Event kinds passed to the host's `event` import.
+#[repr(u32)]
+#[derive(Clone, Copy)]
+pub enum Event {
+    /// UTF-8 text worth logging.
+    Log = 1,
+    /// The session is active: `[width u16][height u16]`.
+    Connected = 2,
+    /// An H.264 picture ([`wire::h264_payload`]), for the viewer to decode.
+    H264 = 3,
+    /// Pixels of the composited image that changed ([`wire::image_payload`]).
+    Image = 4,
+    /// The server issued an auto-reconnect cookie: `[logon id u32]`. The cookie stays here.
+    ReconnectCookie = 5,
+    /// The remote session ID: `[u32]`.
+    SessionId = 6,
+    /// The session ended: `[`[`End`]` u8][UTF-8 reason]`.
+    Ended = 7,
+    /// The desktop changed size: `[width u16][height u16]`.
+    DesktopSize = 8,
+}
+
+impl Event {
+    #[expect(clippy::as_conversions, reason = "reads the repr(u32) discriminant")]
+    fn code(self) -> u32 {
+        self as u32
+    }
+}
+
+#[cfg(target_family = "wasm")]
+mod host {
+    #[link(wasm_import_module = "tessera")]
+    unsafe extern "C" {
+        pub(super) fn recv(ptr: *mut u8, cap: usize) -> i32;
+        pub(super) fn send(ptr: *const u8, len: usize) -> i32;
+        pub(super) fn upgrade_tls(ptr: *mut u8, cap: usize) -> i32;
+        pub(super) fn event(kind: u32, ptr: *const u8, len: usize);
+    }
+}
+
+// The host functions exist only inside a WebAssembly host; native builds are for unit tests.
+#[cfg(not(target_family = "wasm"))]
+mod host {
+    pub(super) unsafe fn recv(_ptr: *mut u8, _cap: usize) -> i32 {
+        -1
+    }
+    pub(super) unsafe fn send(_ptr: *const u8, _len: usize) -> i32 {
+        -1
+    }
+    pub(super) unsafe fn upgrade_tls(_ptr: *mut u8, _cap: usize) -> i32 {
+        -1
+    }
+    pub(super) unsafe fn event(_kind: u32, _ptr: *const u8, _len: usize) {}
+}
+
+fn emit(kind: Event, payload: &[u8]) {
+    // SAFETY: the host reads `payload.len()` bytes at `payload.as_ptr()` during the call.
+    unsafe { host::event(kind.code(), payload.as_ptr(), payload.len()) }
+}
+
+fn log(text: &str) {
+    emit(Event::Log, text.as_bytes());
+}
+
+fn emit_size(kind: Event, width: u16, height: u16) {
+    let mut payload = width.to_le_bytes().to_vec();
+    payload.extend_from_slice(&height.to_le_bytes());
+    emit(kind, &payload);
+}
+
+fn receive() -> Result<Message, String> {
+    let mut buffer = vec![0u8; 64 * 1024];
+    // SAFETY: the host writes at most `buffer.len()` bytes into `buffer`.
+    let length = unsafe { host::recv(buffer.as_mut_ptr(), buffer.len()) };
+    let length = usize::try_from(length).map_err(|_| "host recv failed".to_owned())?;
+    buffer.truncate(length);
+    wire::parse_message(&buffer)
+}
+
+fn transmit(bytes: &[u8]) -> io::Result<()> {
+    // SAFETY: the host reads `bytes.len()` bytes at `bytes.as_ptr()` during the call.
+    let status = unsafe { host::send(bytes.as_ptr(), bytes.len()) };
+    if status < 0 {
+        return Err(io::Error::other("host send failed"));
+    }
+    Ok(())
+}
+
+/// The server connection during the connection sequence. Only server bytes matter then; the host
+/// doesn't send input before `Connected`, and a quit ends the stream.
+#[derive(Default)]
+struct ServerStream {
+    unread: Vec<u8>,
+}
+
+impl Read for ServerStream {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        while self.unread.is_empty() {
+            match receive().map_err(io::Error::other)? {
+                Message::ServerBytes(bytes) => self.unread = bytes,
+                Message::Quit | Message::End => return Ok(0),
+                _ => {}
+            }
+        }
+        let count = buf.len().min(self.unread.len());
+        buf[..count].copy_from_slice(&self.unread[..count]);
+        self.unread.drain(..count);
+        Ok(count)
+    }
+}
+
+impl Write for ServerStream {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        transmit(buf)?;
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+/// CredSSP only uses the network for Kerberos; NTLM, a password login, never does.
+struct NoNetwork;
+
+impl NetworkClient for NoNetwork {
+    fn send(&self, _request: &NetworkRequest) -> sspi::Result<Vec<u8>> {
+        Err(sspi::Error::new(
+            sspi::ErrorKind::NoAuthenticatingAuthority,
+            "this client has no network access for Kerberos",
+        ))
+    }
+}
+
+/// Hands each H.264 picture to the host instead of decoding it.
+struct HostPresentedH264;
+
+impl H264Decoder for HostPresentedH264 {
+    fn decode(&mut self, _data: &[u8]) -> DecoderResult<DecodedFrame> {
+        // Unreachable: a decoder that presents frames is handed them through `present`.
+        Err(DecoderError::msg("H.264 is decoded by the viewer"))
+    }
+
+    fn presents_frames(&self) -> bool {
+        true
+    }
+
+    fn present(&mut self, surface_id: u16, data: &[u8], regions: &[ExclusiveRectangle]) {
+        emit(Event::H264, &wire::h264_payload(surface_id, regions, data));
+    }
+}
+
+fn connector_config(config: &Config) -> connector::Config {
+    connector::Config {
+        credentials: Credentials::UsernamePassword {
+            username: config.username.clone(),
+            password: config.password.clone(),
+        },
+        domain: config.domain.clone(),
+        enable_tls: true,
+        enable_credssp: true,
+        enable_standard_rdp_security: false,
+        keyboard_type: ironrdp::pdu::gcc::KeyboardType::IBM_ENHANCED,
+        keyboard_subtype: 0,
+        keyboard_layout: 0,
+        keyboard_functional_keys_count: 12,
+        connection_type: ironrdp::pdu::gcc::ConnectionType::Lan,
+        ime_file_name: String::new(),
+        dig_product_id: String::new(),
+        desktop_size: connector::DesktopSize {
+            width: config.width,
+            height: config.height,
+        },
+        monitor_layout: None,
+        bitmap: Some(connector::BitmapConfig {
+            color_depth: 16,
+            lossy_compression: true,
+            codecs: client_codecs_capabilities(&[]).expect("can't panic for &[]"),
+        }),
+        client_build: 0,
+        client_name: "tessera".to_owned(),
+        // Like FreeRDP and the web client.
+        client_dir: "C:\\Windows\\System32\\mstscax.dll".to_owned(),
+        platform: MajorPlatformType::UNSPECIFIED,
+        compression_type: None,
+        // The viewer shows its own pointer.
+        enable_server_pointer: false,
+        autologon: false,
+        enable_audio_playback: false,
+        enable_audio_capture: false,
+        request_data: None,
+        pointer_software_rendering: false,
+        multitransport_flags: None,
+        support_dyn_vc_gfx_protocol: true,
+        performance_flags: PerformanceFlags::default(),
+        desktop_scale_factor: 0,
+        desktop_physical_size: None,
+        desktop_orientation: None,
+        device_scale_factor: None,
+        monitor_extended_layout: None,
+        relative_mouse_input: false,
+        hardware_id: None,
+        license_cache: None,
+        timezone_info: TimezoneInfo::default(),
+        alternate_shell: String::new(),
+        work_dir: String::new(),
+        remote_application_mode: false,
+        rail_support_level: RailSupportLevel::SUPPORTED,
+    }
+}
+
+/// Why `run` returned.
+struct Ending(End, String);
+
+impl Ending {
+    fn error(reason: impl core::fmt::Display) -> Self {
+        Self(End::Error, reason.to_string())
+    }
+}
+
+struct Session {
+    active_stage: ActiveStage,
+    image: DecodedImage,
+    activation_factory: ConnectionActivationFactory,
+    refresh_rect_support: bool,
+    suppress_output_support: bool,
+    input: Database,
+    /// Server bytes not yet framed into PDUs.
+    pending: BytesMut,
+    /// Host messages that arrived while a reactivation was reading server bytes.
+    deferred: VecDeque<Message>,
+}
+
+impl Session {
+    fn next_message(&mut self) -> Result<Message, Ending> {
+        match self.deferred.pop_front() {
+            Some(message) => Ok(message),
+            None => receive().map_err(Ending::error),
+        }
+    }
+
+    /// Reads the next PDU the hint matches, dropping any it doesn't, as `Framed::read_by_hint`
+    /// does. Host messages other than server bytes wait in `deferred`.
+    fn read_by_hint(&mut self, hint: &dyn PduHint) -> Result<Bytes, Ending> {
+        loop {
+            if let Some((matched, length)) = hint.find_size(&self.pending).map_err(Ending::error)? {
+                if self.pending.len() >= length {
+                    let pdu = self.pending.split_to(length).freeze();
+                    if matched {
+                        return Ok(pdu);
+                    }
+                    continue;
+                }
+            }
+            match receive().map_err(Ending::error)? {
+                Message::ServerBytes(bytes) => self.pending.extend_from_slice(&bytes),
+                Message::Quit => return Err(Ending(End::Quit, "quit during reactivation".to_owned())),
+                Message::End => return Err(Ending(End::ConnectionLost, "the connection closed".to_owned())),
+                message => self.deferred.push_back(message),
+            }
+        }
+    }
+
+    /// The Deactivation-Reactivation Sequence ([MS-RDPBCGR] 1.3.1.3), after a Deactivate All PDU.
+    fn reactivate(&mut self) -> Result<(), Ending> {
+        let mut activation = self.activation_factory.create();
+        let mut buf = WriteBuf::new();
+        loop {
+            buf.clear();
+            let written = match activation.next_pdu_hint() {
+                Some(hint) => {
+                    let pdu = self.read_by_hint(hint)?;
+                    activation.step(&pdu, None, &mut buf)
+                }
+                None => activation.step_no_input(&mut buf),
+            }
+            .map_err(|error| Ending::error(format!("reactivation: {error}")))?;
+            if let Some(length) = written.size() {
+                transmit(&buf[..length]).map_err(Ending::error)?;
+            }
+            if let ConnectionActivationState::Finalized {
+                desktop_size,
+                share_id,
+                static_channel_chunk_size,
+                enable_server_pointer,
+                pointer_software_rendering,
+                refresh_rect_support,
+                suppress_output_support,
+                window_support_level,
+                ..
+            } = activation.connection_activation_state()
+            {
+                self.image = DecodedImage::new(PixelFormat::RgbA32, desktop_size.width, desktop_size.height);
+                if !self.active_stage.reactivate(
+                    activation.io_channel_id(),
+                    activation.user_channel_id(),
+                    share_id,
+                    enable_server_pointer,
+                    pointer_software_rendering,
+                    static_channel_chunk_size,
+                ) {
+                    return Err(Ending::error("reactivation: invalid static channel chunk size"));
+                }
+                self.active_stage.set_window_support_level(window_support_level);
+                self.refresh_rect_support = refresh_rect_support;
+                self.suppress_output_support = suppress_output_support;
+                emit_size(Event::DesktopSize, desktop_size.width, desktop_size.height);
+                log("reactivated");
+                return Ok(());
+            }
+        }
+    }
+
+    fn handle(&mut self, outputs: Vec<ActiveStageOutput>) -> Result<(), Ending> {
+        for output in outputs {
+            match output {
+                ActiveStageOutput::ResponseFrame(bytes) => transmit(&bytes).map_err(Ending::error)?,
+                ActiveStageOutput::GraphicsUpdate(region) => {
+                    if let Some(payload) = wire::image_payload(self.image.data(), self.image.width(), &region) {
+                        emit(Event::Image, &payload);
+                    }
+                }
+                ActiveStageOutput::AutoReconnectCookie(cookie) => {
+                    emit(Event::ReconnectCookie, &cookie.logon_id.to_le_bytes());
+                    if let Ok(mut slot) = RECONNECT_COOKIE.lock() {
+                        *slot = Some(cookie);
+                    }
+                }
+                ActiveStageOutput::SessionId(id) => emit(Event::SessionId, &id.to_le_bytes()),
+                ActiveStageOutput::AutoReconnectFailed => log("the server rejected the auto-reconnect cookie"),
+                ActiveStageOutput::LogonErrors(errors) => log(&format!("logon errors: {errors:?}")),
+                ActiveStageOutput::DeactivateAll => self.reactivate()?,
+                ActiveStageOutput::ServerRedirection(_) => {
+                    return Err(Ending::error(
+                        "the server redirected the session, which is not supported",
+                    ));
+                }
+                ActiveStageOutput::Terminate(reason) => return Err(Ending(End::Server, reason.to_string())),
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+
+    /// Processes the server bytes in `pending` that form whole PDUs.
+    fn process_pending(&mut self) -> Result<(), Ending> {
+        while let Some(info) = ironrdp::pdu::find_size(&self.pending).map_err(Ending::error)? {
+            if self.pending.len() < info.length {
+                break;
+            }
+            let frame = self.pending.split_to(info.length);
+            let size = (self.image.width(), self.image.height());
+            let outputs = self
+                .active_stage
+                .process(&mut self.image, info.action, &frame, None)
+                .map_err(Ending::error)?;
+            self.handle(outputs)?;
+            // A graphics pipeline ResetGraphics resizes the image without a reactivation.
+            if (self.image.width(), self.image.height()) != size {
+                emit_size(Event::DesktopSize, self.image.width(), self.image.height());
+            }
+        }
+        Ok(())
+    }
+
+    fn apply_input(&mut self, inputs: Vec<Input>) -> Result<(), Ending> {
+        let mut operations = Vec::new();
+        let mut events = Vec::new();
+        for input in inputs {
+            match input {
+                Input::Operation(operation) => operations.push(operation),
+                Input::ReleaseAll => {
+                    events.extend(self.input.apply(operations.drain(..)));
+                    events.extend(self.input.release_all());
+                }
+            }
+        }
+        events.extend(self.input.apply(operations));
+        if events.is_empty() {
+            return Ok(());
+        }
+        let outputs = self
+            .active_stage
+            .process_fastpath_input(&mut self.image, &events)
+            .map_err(Ending::error)?;
+        self.handle(outputs)
+    }
+
+    fn suppress_output(&mut self, allow: bool) -> Result<(), Ending> {
+        let desktop_rect = allow.then(|| InclusiveRectangle {
+            left: 0,
+            top: 0,
+            right: self.image.width().saturating_sub(1),
+            bottom: self.image.height().saturating_sub(1),
+        });
+        let mut frame = WriteBuf::new();
+        self.active_stage
+            .encode_static(
+                &mut frame,
+                ShareDataPdu::SuppressOutput(SuppressOutputPdu { desktop_rect }),
+            )
+            .map_err(Ending::error)?;
+        transmit(frame.filled()).map_err(Ending::error)
+    }
+
+    fn run(&mut self) -> Ending {
+        loop {
+            if let Err(ending) = self.process_pending() {
+                return ending;
+            }
+            let result = match self.next_message() {
+                Ok(Message::ServerBytes(bytes)) => {
+                    self.pending.extend_from_slice(&bytes);
+                    Ok(())
+                }
+                Ok(Message::SuppressOutput { allow }) => self.suppress_output(allow),
+                Ok(Message::Input(inputs)) => self.apply_input(inputs),
+                Ok(Message::Resize { width, height }) => {
+                    match self
+                        .active_stage
+                        .encode_resize(u32::from(width), u32::from(height), None, None)
+                    {
+                        Some(frame) => frame
+                            .map_err(Ending::error)
+                            .and_then(|frame| transmit(&frame).map_err(Ending::error)),
+                        None => {
+                            log("the server doesn't support resizing");
+                            Ok(())
+                        }
+                    }
+                }
+                Ok(Message::Refresh) => self
+                    .active_stage
+                    .request_full_redraw(
+                        self.image.width(),
+                        self.image.height(),
+                        self.refresh_rect_support,
+                        self.suppress_output_support,
+                    )
+                    .map_err(Ending::error)
+                    .and_then(|frames| {
+                        frames
+                            .iter()
+                            .try_for_each(|frame| transmit(frame).map_err(Ending::error))
+                    }),
+                Ok(Message::Quit) => {
+                    let shutdown = self.active_stage.graceful_shutdown().map_err(Ending::error);
+                    let sent = shutdown.and_then(|outputs| {
+                        outputs.iter().try_for_each(|output| match output {
+                            ActiveStageOutput::ResponseFrame(bytes) => transmit(bytes).map_err(Ending::error),
+                            _ => Ok(()),
+                        })
+                    });
+                    return match sent {
+                        Ok(()) => Ending(End::Quit, "quit".to_owned()),
+                        Err(ending) => ending,
+                    };
+                }
+                Ok(Message::End) => return Ending(End::ConnectionLost, "the connection closed".to_owned()),
+                Err(ending) => return ending,
+            };
+            if let Err(ending) = result {
+                return ending;
+            }
+        }
+    }
+}
+
+fn connect(config: &Config) -> Result<Session, Ending> {
+    struct EgfxHandler;
+    impl GraphicsPipelineHandler for EgfxHandler {}
+
+    let decoder = config
+        .h264
+        .then(|| -> Box<dyn H264Decoder> { Box::new(HostPresentedH264) });
+    let mut connector = ClientConnector::new(
+        connector_config(config),
+        SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::LOCALHOST, 33899)),
+    );
+    if config.rejoin {
+        let cookie = RECONNECT_COOKIE
+            .lock()
+            .map_err(|_| Ending::error("cookie lock poisoned"))?
+            .clone();
+        match cookie {
+            Some(cookie) => {
+                log(&format!(
+                    "rejoining logon {} with its auto-reconnect cookie",
+                    cookie.logon_id
+                ));
+                connector = connector.with_auto_reconnect_cookie(cookie);
+            }
+            None => log("no auto-reconnect cookie to rejoin with"),
+        }
+    }
+    connector.attach_static_channel(
+        DrdynvcClient::new()
+            .with_dynamic_channel(DisplayControlClient::new(|_| Ok(Vec::new())))
+            .with_dynamic_channel(GraphicsPipelineClient::new(Box::new(EgfxHandler), decoder)),
+    );
+
+    let mut framed = Framed::new(ServerStream::default());
+    let should_upgrade = ironrdp_blocking::connect_begin(&mut framed, &mut connector)
+        .map_err(|error| Ending::error(format!("connect: {error}")))?;
+    let stream = framed.into_inner_no_leftover();
+
+    let mut public_key = vec![0u8; 16 * 1024];
+    // SAFETY: the host writes at most `public_key.len()` bytes into `public_key`.
+    let length = unsafe { host::upgrade_tls(public_key.as_mut_ptr(), public_key.len()) };
+    let length = usize::try_from(length).map_err(|_| Ending::error("TLS upgrade failed"))?;
+    public_key.truncate(length);
+
+    let upgraded = ironrdp_blocking::mark_as_upgraded(should_upgrade, &mut connector);
+    let mut framed = Framed::new(stream);
+    let outcome = ironrdp_blocking::connect_finalize(
+        upgraded,
+        connector,
+        &mut framed,
+        &mut NoNetwork,
+        ServerName::new(config.server_name.clone()),
+        public_key,
+        None,
+    )
+    .map_err(|error| Ending::error(format!("connect: {error}")))?;
+    let ConnectionOutcome::Connected(connection_result) = outcome else {
+        return Err(Ending::error(
+            "the server redirected the connection, which is not supported",
+        ));
+    };
+
+    emit_size(
+        Event::Connected,
+        connection_result.desktop_size.width,
+        connection_result.desktop_size.height,
+    );
+    let image = DecodedImage::new(
+        PixelFormat::RgbA32,
+        connection_result.desktop_size.width,
+        connection_result.desktop_size.height,
+    );
+    let active_stage = ActiveStageBuilder {
+        static_channels: connection_result.static_channels,
+        user_channel_id: connection_result.user_channel_id,
+        io_channel_id: connection_result.io_channel_id,
+        message_channel_id: connection_result.message_channel_id,
+        share_id: connection_result.share_id,
+        compression_type: connection_result.compression_type,
+        enable_server_pointer: connection_result.enable_server_pointer,
+        pointer_software_rendering: connection_result.pointer_software_rendering,
+    }
+    .build();
+    let (_stream, leftover) = framed.into_inner();
+    Ok(Session {
+        active_stage,
+        image,
+        activation_factory: connection_result.activation_factory,
+        refresh_rect_support: connection_result.refresh_rect_support,
+        suppress_output_support: connection_result.suppress_output_support,
+        input: Database::new(),
+        pending: BytesMut::from(&*leftover),
+        deferred: VecDeque::new(),
+    })
+}
+
+/// Allocates `len` bytes for the host to write the configuration into. The memory is leaked: one
+/// configuration per run.
+#[unsafe(no_mangle)]
+pub extern "C" fn alloc(len: usize) -> *mut u8 {
+    Box::leak(vec![0u8; len].into_boxed_slice()).as_mut_ptr()
+}
+
+/// Runs one session from the configuration at `ptr`, until it ends. Returns the [`End`] code,
+/// which the `Ended` event also carries with the reason.
+///
+/// # Safety
+///
+/// `ptr` must point to `len` readable bytes, such as a buffer from [`alloc`].
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn run(ptr: *const u8, len: usize) -> i32 {
+    // SAFETY: the caller guarantees `len` readable bytes at `ptr`.
+    let bytes = unsafe { core::slice::from_raw_parts(ptr, len) };
+    let Ending(end, reason) = match wire::parse_config(bytes) {
+        None => Ending::error("invalid configuration"),
+        Some(config) => match connect(&config) {
+            Ok(mut session) => session.run(),
+            Err(ending) => ending,
+        },
+    };
+    let mut payload = vec![end.code()];
+    payload.extend_from_slice(reason.as_bytes());
+    emit(Event::Ended, &payload);
+    i32::from(end.code())
+}
