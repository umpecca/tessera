+//! The byte formats between the host and the module: the configuration the host passes to `run`,
+//! the messages it returns from `recv`, and the event payloads the module reports.
+//!
+//! Integers are little-endian. Strings are `[u16 length][UTF-8]`.
+
+use ironrdp::input::{MouseButton, MousePosition, Operation, Scancode, WheelRotations};
+use ironrdp::pdu::geometry::{ExclusiveRectangle, InclusiveRectangle, Rectangle as _};
+
+/// Bytes from the server.
+pub const TAG_SERVER_BYTES: u8 = 0;
+/// `[allow u8]`: 1 resumes the server's display updates, 0 suppresses them.
+pub const TAG_SUPPRESS_OUTPUT: u8 = 1;
+/// End the session gracefully.
+pub const TAG_QUIT: u8 = 2;
+/// Input records (see [`parse_input`]).
+pub const TAG_INPUT: u8 = 3;
+/// `[width u16][height u16]`: ask the server for a new desktop size.
+pub const TAG_RESIZE: u8 = 4;
+/// Ask the server to send the whole screen again.
+pub const TAG_REFRESH: u8 = 5;
+
+const INPUT_MOUSE_MOVE: u8 = 1;
+const INPUT_MOUSE_BUTTON: u8 = 2;
+const INPUT_WHEEL: u8 = 3;
+const INPUT_KEY: u8 = 4;
+const INPUT_UNICODE: u8 = 5;
+const INPUT_RELEASE_ALL: u8 = 6;
+
+/// How a session ended, the first byte of the `Ended` event.
+#[repr(u8)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum End {
+    /// The host asked to quit.
+    Quit = 0,
+    /// The connection closed or failed without the server ending the session: a rejoin can
+    /// resume it.
+    ConnectionLost = 1,
+    /// The server ended the session.
+    Server = 2,
+    /// The session could not start or broke.
+    Error = 3,
+}
+
+impl End {
+    #[expect(clippy::as_conversions, reason = "reads the repr(u8) discriminant")]
+    pub fn code(self) -> u8 {
+        self as u8
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub struct Config {
+    pub server_name: String,
+    pub username: String,
+    pub password: String,
+    pub domain: Option<String>,
+    pub width: u16,
+    pub height: u16,
+    /// Offer H.264, which the module hands to the host undecoded.
+    pub h264: bool,
+    /// Present the last auto-reconnect cookie, to rejoin that session.
+    pub rejoin: bool,
+}
+
+const CONFIG_H264: u8 = 1;
+const CONFIG_REJOIN: u8 = 2;
+
+struct Reader<'a>(&'a [u8]);
+
+impl<'a> Reader<'a> {
+    fn take(&mut self, count: usize) -> Option<&'a [u8]> {
+        let (head, tail) = self.0.split_at_checked(count)?;
+        self.0 = tail;
+        Some(head)
+    }
+
+    fn u8(&mut self) -> Option<u8> {
+        Some(self.take(1)?[0])
+    }
+
+    fn u16(&mut self) -> Option<u16> {
+        Some(u16::from_le_bytes(self.take(2)?.try_into().ok()?))
+    }
+
+    fn i16(&mut self) -> Option<i16> {
+        Some(i16::from_le_bytes(self.take(2)?.try_into().ok()?))
+    }
+
+    fn u32(&mut self) -> Option<u32> {
+        Some(u32::from_le_bytes(self.take(4)?.try_into().ok()?))
+    }
+
+    fn string(&mut self) -> Option<String> {
+        let length = usize::from(self.u16()?);
+        String::from_utf8(self.take(length)?.to_vec()).ok()
+    }
+
+    fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+}
+
+/// The configuration: server name, user name, password and domain (empty for none) as strings,
+/// then width u16, height u16 and flags u8 (bit 0: H.264; bit 1: rejoin with the last cookie).
+pub fn parse_config(bytes: &[u8]) -> Option<Config> {
+    let mut reader = Reader(bytes);
+    let server_name = reader.string()?;
+    let username = reader.string()?;
+    let password = reader.string()?;
+    let domain = reader.string()?;
+    let width = reader.u16()?;
+    let height = reader.u16()?;
+    let flags = reader.u8()?;
+    if !reader.is_empty() || width == 0 || height == 0 {
+        return None;
+    }
+    Some(Config {
+        server_name,
+        username,
+        password,
+        domain: (!domain.is_empty()).then_some(domain),
+        width,
+        height,
+        h264: flags & CONFIG_H264 != 0,
+        rejoin: flags & CONFIG_REJOIN != 0,
+    })
+}
+
+#[derive(Debug)]
+pub enum Message {
+    ServerBytes(Vec<u8>),
+    SuppressOutput {
+        allow: bool,
+    },
+    Quit,
+    Input(Vec<Input>),
+    Resize {
+        width: u16,
+        height: u16,
+    },
+    Refresh,
+    /// The host has nothing more: the connection is gone.
+    End,
+}
+
+#[derive(Debug)]
+pub enum Input {
+    Operation(Operation),
+    ReleaseAll,
+}
+
+pub fn parse_message(buffer: &[u8]) -> Result<Message, String> {
+    let Some((&tag, payload)) = buffer.split_first() else {
+        return Ok(Message::End);
+    };
+    match tag {
+        TAG_SERVER_BYTES => Ok(Message::ServerBytes(payload.to_vec())),
+        TAG_SUPPRESS_OUTPUT => Ok(Message::SuppressOutput {
+            allow: payload.first() == Some(&1),
+        }),
+        TAG_QUIT => Ok(Message::Quit),
+        TAG_INPUT => parse_input(payload).map(Message::Input),
+        TAG_RESIZE => {
+            let mut reader = Reader(payload);
+            match (reader.u16(), reader.u16()) {
+                (Some(width), Some(height)) if width > 0 && height > 0 => Ok(Message::Resize { width, height }),
+                _ => Err("invalid resize message".to_owned()),
+            }
+        }
+        TAG_REFRESH => Ok(Message::Refresh),
+        tag => Err(format!("unknown host message tag {tag}")),
+    }
+}
+
+/// Input records, each `[kind u8]` and its fields:
+///
+/// - mouse move: `[x u16][y u16]`
+/// - mouse button: `[button u8 (0 left, 1 middle, 2 right, 3 back, 4 forward)][pressed u8]`
+/// - wheel: `[vertical u8][rotation units i16]`
+/// - key: `[scan code u16, with 0xE0 in the high byte for extended keys][pressed u8]`
+/// - Unicode character: `[code point u32][pressed u8]`
+/// - release everything pressed: no fields
+pub fn parse_input(payload: &[u8]) -> Result<Vec<Input>, String> {
+    let mut reader = Reader(payload);
+    let mut inputs = Vec::new();
+    let invalid = || "invalid input record".to_owned();
+    while !reader.is_empty() {
+        let input = match reader.u8().ok_or_else(invalid)? {
+            INPUT_MOUSE_MOVE => {
+                let x = reader.u16().ok_or_else(invalid)?;
+                let y = reader.u16().ok_or_else(invalid)?;
+                Input::Operation(Operation::MouseMove(MousePosition { x, y }))
+            }
+            INPUT_MOUSE_BUTTON => {
+                let button =
+                    MouseButton::from_idx(usize::from(reader.u8().ok_or_else(invalid)?)).ok_or_else(invalid)?;
+                Input::Operation(if reader.u8().ok_or_else(invalid)? != 0 {
+                    Operation::MouseButtonPressed(button)
+                } else {
+                    Operation::MouseButtonReleased(button)
+                })
+            }
+            INPUT_WHEEL => {
+                let is_vertical = reader.u8().ok_or_else(invalid)? != 0;
+                let rotation_units = reader.i16().ok_or_else(invalid)?;
+                Input::Operation(Operation::WheelRotations(WheelRotations {
+                    is_vertical,
+                    rotation_units,
+                }))
+            }
+            INPUT_KEY => {
+                let scancode = Scancode::from_u16(reader.u16().ok_or_else(invalid)?);
+                Input::Operation(if reader.u8().ok_or_else(invalid)? != 0 {
+                    Operation::KeyPressed(scancode)
+                } else {
+                    Operation::KeyReleased(scancode)
+                })
+            }
+            INPUT_UNICODE => {
+                let character = char::from_u32(reader.u32().ok_or_else(invalid)?).ok_or_else(invalid)?;
+                Input::Operation(if reader.u8().ok_or_else(invalid)? != 0 {
+                    Operation::UnicodeKeyPressed(character)
+                } else {
+                    Operation::UnicodeKeyReleased(character)
+                })
+            }
+            INPUT_RELEASE_ALL => Input::ReleaseAll,
+            _ => return Err(invalid()),
+        };
+        inputs.push(input);
+    }
+    Ok(inputs)
+}
+
+/// `[surface u16][region count u16][x, y, width, height u16 each][Annex B data]`.
+pub fn h264_payload(surface_id: u16, regions: &[ExclusiveRectangle], data: &[u8]) -> Vec<u8> {
+    let mut payload = Vec::with_capacity(4 + regions.len() * 8 + data.len());
+    payload.extend_from_slice(&surface_id.to_le_bytes());
+    payload.extend_from_slice(&u16::try_from(regions.len()).unwrap_or(u16::MAX).to_le_bytes());
+    for region in regions.iter().take(usize::from(u16::MAX)) {
+        for value in [
+            region.left,
+            region.top,
+            region.right.saturating_sub(region.left),
+            region.bottom.saturating_sub(region.top),
+        ] {
+            payload.extend_from_slice(&value.to_le_bytes());
+        }
+    }
+    payload.extend_from_slice(data);
+    payload
+}
+
+/// `[x u16][y u16][width u16][height u16][RGBA rows]` for `region` of an RGBA image `image_width`
+/// pixels wide, or `None` if the region doesn't fit in `image`.
+pub fn image_payload(image: &[u8], image_width: u16, region: &InclusiveRectangle) -> Option<Vec<u8>> {
+    let (x, y) = (usize::from(region.left), usize::from(region.top));
+    let (width, height) = (usize::from(region.width()), usize::from(region.height()));
+    let stride = usize::from(image_width).checked_mul(4)?;
+    if x.checked_add(width)? > usize::from(image_width) {
+        return None;
+    }
+    let mut payload = Vec::with_capacity(8 + width * height * 4);
+    for value in [region.left, region.top, region.width(), region.height()] {
+        payload.extend_from_slice(&value.to_le_bytes());
+    }
+    for row in y..y.checked_add(height)? {
+        let start = row.checked_mul(stride)?.checked_add(x * 4)?;
+        payload.extend_from_slice(image.get(start..start.checked_add(width * 4)?)?);
+    }
+    Some(payload)
+}
