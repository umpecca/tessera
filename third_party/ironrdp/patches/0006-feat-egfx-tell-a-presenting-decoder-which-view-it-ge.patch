+/// Which picture of an AVC update a [presenting decoder](H264Decoder::presents_frames) is handed.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PresentedView {
+    /// An AVC420 picture ([MS-RDPEGFX] 2.2.4.4).
+    ///
+    /// [MS-RDPEGFX]: https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-rdpegfx/da5c75f9-cd99-450c-98c4-014a496942b0
+    Avc420,
+    /// The main view of an AVC444 picture ([MS-RDPEGFX] 2.2.4.5 and 2.2.4.6): luma and
+    /// subsampled chroma, an ordinary 4:2:0 picture.
+    ///
+    /// [MS-RDPEGFX]: https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-rdpegfx/da5c75f9-cd99-450c-98c4-014a496942b0
+    Avc444Main {
+        layout: Avc444Layout,
+        /// The auxiliary view of the same update is handed over next.
+        auxiliary_follows: bool,
+    },
+    /// The auxiliary view of an AVC444 picture: the chroma samples the main view leaves out,
+    /// packed as `layout` says.
+    Avc444Auxiliary { layout: Avc444Layout },
+}
+
 /// Trait for H.264 (AVC) decoders
 ///
 /// Implement this trait to provide H.264 decode capability to the
@@ -350,19 +373,21 @@ pub trait H264Decoder: Send {
     /// Such a decoder receives every AVC420 frame, and each view of an AVC444 frame, through
     /// [`Self::present`]. [`Self::decode`] and [`Self::decode_yuv420`] are not called for them,
     /// and the client-side compositor does not paint their regions. AVC444 is advertised for a
-    /// presenting decoder too: it shows the main view, an ordinary 4:2:0 picture, and decodes
-    /// the auxiliary view only to keep the H.264 stream both views share in step.
+    /// presenting decoder too: it may combine both views into a 4:4:4 picture, or show the
+    /// main view, an ordinary 4:2:0 picture, and decode the auxiliary view only to keep the
+    /// H.264 stream both views share in step.
     fn presents_frames(&self) -> bool {
         false
     }
 
-    /// Decodes `data` and shows the picture's `regions` of surface `surface_id`, for a decoder
-    /// that [presents frames](Self::presents_frames).
+    /// Decodes `data`, the `view` of an update to surface `surface_id`, for a decoder that
+    /// [presents frames](Self::presents_frames). `regions` are the parts of the surface the
+    /// view updates.
     ///
-    /// With no regions, the picture is decoded but not shown: an AVC444 auxiliary view, or a
-    /// main view whose update has no region rectangles.
-    fn present(&mut self, surface_id: u16, data: &[u8], regions: &[ExclusiveRectangle]) {
-        let _ = (surface_id, data, regions);
+    /// With no regions, the picture is decoded but updates nothing, such as a main view
+    /// whose update has no region rectangles.
+    fn present(&mut self, surface_id: u16, view: PresentedView, data: &[u8], regions: &[ExclusiveRectangle]) {
+        let _ = (surface_id, view, data, regions);
     }
 
     /// Reset the decoder state
