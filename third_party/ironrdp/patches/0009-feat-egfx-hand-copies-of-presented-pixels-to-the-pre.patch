+
+    fn present_output(&mut self, surface_id: u16, origin: Option<(u32, u32)>) {
+        self.1
+            .lock()
+            .expect("operations")
+            .push(format!("output {surface_id} {origin:?}"));
+    }
+
+    fn present_copy(&mut self, source: u16, source_rectangle: &ExclusiveRectangle, destination: u16, points: &[Point]) {
+        let points: Vec<_> = points.iter().map(|point| (point.x, point.y)).collect();
+        self.1.lock().expect("operations").push(format!(
+            "copy {source} ({},{})-({},{}) to {destination} at {points:?}",
+            source_rectangle.left, source_rectangle.top, source_rectangle.right, source_rectangle.bottom
+        ));
+    }
+
+    fn reset(&mut self) {
+        self.1.lock().expect("operations").push("reset".to_owned());
+    }
 }
 
