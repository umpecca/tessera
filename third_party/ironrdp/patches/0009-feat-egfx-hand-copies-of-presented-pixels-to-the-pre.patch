+fn presenting_client_with_operations() -> (GraphicsPipelineClient, PresentedOps) {
+    let operations = PresentedOps::default();
+    let client = setup_active_client_with_surface(
+        Some(Box::new(PresentingDecoder(
+            Presented::default(),
+            PresentedOps::clone(&operations),
+        ))),
+        1,
+        64,
+        64,
+    );
+    (client, operations)
+}
+
+fn process_all(client: &mut GraphicsPipelineClient, pdus: &[GfxPdu]) {
+    for pdu in pdus {
+        client.process(0, &encode_for_process(pdu)).expect("PDU is processed");
+    }
+}
+
+fn avc420_to(surface_id: u16, rect: ExclusiveRectangle) -> GfxPdu {
+    let stream = avc420_stream(vec![rect.clone()], &[0x00, 0x00, 0x00, 0x01, 0x65]);
+    GfxPdu::WireToSurface1(WireToSurface1Pdu {
+        surface_id,
+        codec_id: Codec1Type::Avc420,
+        pixel_format: PixelFormat::XRgb,
+        destination_rectangle: rect,
+        bitmap_data: encode_vec(&stream).expect("encode AVC420"),
+    })
+}
+
+fn surface_to_surface(source: u16, destination: u16, rect: ExclusiveRectangle, points: Vec<Point>) -> GfxPdu {
+    GfxPdu::SurfaceToSurface(SurfaceToSurfacePdu {
+        source_surface_id: source,
+        destination_surface_id: destination,
+        source_rectangle: rect,
+        destination_points: points,
+    })
+}
+
+/// A 64x64 output showing surface 1, so composited updates reach `drain_output`.
+fn output_with_surface_1() -> [GfxPdu; 3] {
+    [
+        GfxPdu::ResetGraphics(ResetGraphicsPdu {
+            width: 64,
+            height: 64,
+            monitors: Vec::new(),
+        }),
+        create_surface(1, 64, 64),
+        GfxPdu::MapSurfaceToOutput(MapSurfaceToOutputPdu {
+            surface_id: 1,
+            output_origin_x: 0,
+            output_origin_y: 0,
+        }),
+    ]
+}
+
+// oracle: spec MS-RDPEGFX §2.2.2.6 (SurfaceToSurface copies the source surface's pixels)
+#[test]
+fn a_presenting_decoder_copies_from_surfaces_holding_its_pictures() {
+    let (mut client, operations) = presenting_client_with_operations();
+    process_all(&mut client, &output_with_surface_1());
+    process_all(
+        &mut client,
+        &[
+            create_surface(2, 64, 64),
+            avc420_to(2, exclusive(0, 0, 64, 64)),
+            GfxPdu::EndFrame(EndFramePdu { frame_id: 0 }),
+        ],
+    );
+    let _ = client.drain_output();
+    operations.lock().unwrap().clear();
+    process_all(
+        &mut client,
+        &[
+            surface_to_surface(
+                2,
+                1,
+                exclusive(0, 0, 64, 32),
+                vec![Point { x: 0, y: 0 }, Point { x: 0, y: 32 }],
+            ),
+            GfxPdu::EndFrame(EndFramePdu { frame_id: 0 }),
+        ],
+    );
+
+    assert_eq!(
+        *operations.lock().unwrap(),
+        ["copy 2 (0,0)-(64,32) to 1 at [(0, 0), (0, 32)]"]
+    );
+    assert!(
+        client.drain_output().is_empty(),
+        "the compositor's empty copy of the picture is not painted"
+    );
+}
+
+#[test]
+fn a_presenting_decoder_hears_where_surfaces_are_shown() {
+    let (mut client, operations) = presenting_client_with_operations();
+    operations.lock().unwrap().clear();
+    process_all(&mut client, &output_with_surface_1());
+    assert_eq!(
+        *operations.lock().unwrap(),
+        ["reset", "output 1 None", "output 1 Some((0, 0))"]
+    );
+}
+
+#[test]
+fn copies_onward_from_a_surface_that_received_presented_pixels_stay_with_the_decoder() {
+    let (mut client, operations) = presenting_client_with_operations();
+    process_all(
+        &mut client,
+        &[
+            avc420_to(1, exclusive(0, 0, 16, 16)),
+            create_surface(2, 64, 64),
+            surface_to_surface(1, 2, exclusive(0, 0, 16, 16), vec![Point { x: 8, y: 8 }]),
+            surface_to_surface(2, 1, exclusive(8, 8, 24, 24), vec![Point { x: 32, y: 32 }]),
+        ],
+    );
+    assert_eq!(
+        *operations.lock().unwrap(),
+        [
+            "output 1 None",
+            "output 2 None",
+            "copy 1 (0,0)-(16,16) to 2 at [(8, 8)]",
+            "copy 2 (8,8)-(24,24) to 1 at [(32, 32)]",
+        ]
+    );
+}
+
+#[test]
+fn the_compositor_keeps_copies_from_surfaces_without_presented_pictures() {
+    let (mut client, operations) = presenting_client_with_operations();
+    process_all(&mut client, &output_with_surface_1());
+    process_all(
+        &mut client,
+        &[
+            GfxPdu::SolidFill(SolidFillPdu {
+                surface_id: 1,
+                fill_pixel: Color {
+                    b: 0,
+                    g: 0,
+                    r: 255,
+                    xa: 255,
+                },
+                rectangles: vec![exclusive(0, 0, 8, 8)],
+            }),
+            GfxPdu::EndFrame(EndFramePdu { frame_id: 0 }),
+        ],
+    );
+    let _ = client.drain_output();
+    process_all(
+        &mut client,
+        &[
+            surface_to_surface(1, 1, exclusive(0, 0, 8, 8), vec![Point { x: 16, y: 16 }]),
+            GfxPdu::EndFrame(EndFramePdu { frame_id: 1 }),
+        ],
+    );
+    assert!(
+        operations
+            .lock()
+            .unwrap()
+            .iter()
+            .all(|operation| !operation.starts_with("copy"))
+    );
+    assert!(!client.drain_output().is_empty(), "the compositor paints its own copy");
+}
+
+#[test]
+fn a_presenting_decoder_hears_when_surfaces_start_over_or_go() {
+    let (mut client, operations) = presenting_client_with_operations();
+    process_all(
+        &mut client,
+        &[
+            avc420_to(1, exclusive(0, 0, 16, 16)),
+            GfxPdu::DeleteSurface(DeleteSurfacePdu { surface_id: 1 }),
+            GfxPdu::CreateSurface(CreateSurfacePdu {
+                surface_id: 1,
+                width: 32,
+                height: 32,
+                pixel_format: PixelFormat::XRgb,
+            }),
+            // A new surface 1 holds no presented pictures: the compositor copies from it.
+            surface_to_surface(1, 1, exclusive(0, 0, 8, 8), vec![Point { x: 8, y: 8 }]),
+            GfxPdu::ResetGraphics(ResetGraphicsPdu {
+                width: 64,
+                height: 64,
+                monitors: Vec::new(),
+            }),
+        ],
+    );
+    assert_eq!(
+        *operations.lock().unwrap(),
+        ["output 1 None", "output 1 None", "output 1 None", "reset"]
+    );
+}
