 type Presented = std::sync::Arc<std::sync::Mutex<Vec<(u16, PresentedView, Vec<u8>, Vec<ExclusiveRectangle>)>>>;
 
-/// Records what it is asked to present, and fails if it is asked to decode instead.
-struct PresentingDecoder(Presented);
+type PresentedOps = std::sync::Arc<std::sync::Mutex<Vec<String>>>;
+
+/// Records what it is asked to present and the surface operations it is handed, and fails if
