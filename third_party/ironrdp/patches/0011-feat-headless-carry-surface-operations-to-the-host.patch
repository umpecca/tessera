+                0xfc, 0xff, 17, 3, 0, //
+                1, 0, 2, 0, 10, 0, 5, 0, //
+                4, 0, 5, 0, 0, 0, 0, 0, //
+                6, 0, 7, 0, 0, 0, 0, 0,
+            ]
+        );
+        assert_eq!(surfaces_reset_payload(), [0, 0, 18, 0, 0]);
+    }
