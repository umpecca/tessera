+// ============================================================================
+// Tests: Decoders That Present Frames Themselves
+// ============================================================================
+
+type Presented = std::sync::Arc<std::sync::Mutex<Vec<(u16, Vec<u8>, Vec<ExclusiveRectangle>)>>>;
+
+/// Records what it is asked to present, and fails if it is asked to decode instead.
+struct PresentingDecoder(Presented);
+
+impl H264Decoder for PresentingDecoder {
+    fn decode(&mut self, _data: &[u8]) -> DecoderResult<DecodedFrame> {
+        Err(DecoderError::msg("a presenting decoder is never asked to decode"))
+    }
+
+    fn presents_frames(&self) -> bool {
+        true
+    }
+
+    fn present(&mut self, surface_id: u16, data: &[u8], regions: &[ExclusiveRectangle]) {
+        self.0
+            .lock()
+            .expect("presented frames")
+            .push((surface_id, data.to_vec(), regions.to_vec()));
+    }
+}
+
+fn presenting_client() -> (GraphicsPipelineClient, Presented) {
+    let presented = Presented::default();
+    let client = setup_active_client_with_surface(Some(Box::new(PresentingDecoder(presented.clone()))), 1, 64, 64);
+    (client, presented)
+}
+
+fn exclusive(left: u16, top: u16, right: u16, bottom: u16) -> ExclusiveRectangle {
+    ExclusiveRectangle {
+        left,
+        top,
+        right,
+        bottom,
+    }
+}
+
+fn avc420_stream(rectangles: Vec<ExclusiveRectangle>, data: &[u8]) -> Avc420BitmapStream<'_> {
+    let quant_qual_vals = rectangles
+        .iter()
+        .map(|_| QuantQuality {
+            quantization_parameter: 22,
+            progressive: false,
+            quality: 100,
+        })
+        .collect();
+    Avc420BitmapStream {
+        rectangles,
+        quant_qual_vals,
+        data,
+    }
+}
+
+fn wire_to_surface(codec_id: Codec1Type, destination_rectangle: ExclusiveRectangle, bitmap_data: Vec<u8>) -> GfxPdu {
+    GfxPdu::WireToSurface1(WireToSurface1Pdu {
+        surface_id: 1,
+        codec_id,
+        pixel_format: PixelFormat::XRgb,
+        destination_rectangle,
+        bitmap_data,
+    })
+}
+
+// oracle: spec MS-RDPEGFX §2.2.4.4 (regionRects are the updated parts of the frame)
+#[test]
+fn a_presenting_decoder_receives_avc420_frames_with_their_regions() {
+    let (mut client, presented) = presenting_client();
+    let regions = vec![exclusive(0, 0, 32, 16), exclusive(16, 32, 48, 64)];
+    let stream = avc420_stream(regions.clone(), &[0x00, 0x00, 0x00, 0x01, 0x65]);
+    let pdu = wire_to_surface(
+        Codec1Type::Avc420,
+        exclusive(0, 0, 48, 64),
+        encode_vec(&stream).expect("encode AVC420"),
+    );
+
+    client
+        .process(0, &encode_for_process(&pdu))
+        .expect("the frame is handed over, not decoded");
+
+    assert_eq!(
+        *presented.lock().unwrap(),
+        [(1, vec![0x00, 0x00, 0x00, 0x01, 0x65], regions)]
+    );
+}
+
+#[test]
+fn a_presenting_decoder_receives_the_destination_when_an_update_has_no_regions() {
+    let (mut client, presented) = presenting_client();
+    let stream = avc420_stream(Vec::new(), &[0x00, 0x00, 0x00, 0x01, 0x65]);
+    let pdu = wire_to_surface(
+        Codec1Type::Avc420,
+        exclusive(8, 8, 40, 24),
+        encode_vec(&stream).expect("encode AVC420"),
+    );
+
+    client
+        .process(0, &encode_for_process(&pdu))
+        .expect("the frame is handed over");
+
+    assert_eq!(presented.lock().unwrap()[0].2, [exclusive(8, 8, 40, 24)]);
+}
+
+#[test]
+fn a_presenting_decoder_gets_avc444_advertised() {
+    let presented = Presented::default();
+    let mut client = GraphicsPipelineClient::new(
+        Box::new(TestHandler::new()),
+        Some(Box::new(PresentingDecoder(presented))),
+    );
+    let messages = client.start(0).expect("start should succeed");
+    let caps_pdu = decode_caps_from_message(&messages[0]);
+    let versions: Vec<_> = caps_pdu.0.iter().map(|cap| cap.version).collect();
+    assert_eq!(versions.first(), Some(&CapabilityVersion::V10_7));
+    assert!(versions.contains(&CapabilityVersion::V8_1));
+}
+
+// oracle: spec MS-RDPEGFX §2.2.4.5 (both views are carried in one H.264 stream)
+#[test]
+fn a_presenting_decoder_decodes_both_avc444_views_and_shows_the_main_one() {
+    let (mut client, presented) = presenting_client();
+    let main_regions = vec![exclusive(0, 0, 64, 32)];
+    let stream = Avc444BitmapStream {
+        encoding: Encoding::LUMA_AND_CHROMA,
+        stream1: avc420_stream(main_regions.clone(), &[0x00, 0x00, 0x00, 0x01, 0x65, 0x01]),
+        stream2: Some(avc420_stream(
+            vec![exclusive(0, 0, 64, 64)],
+            &[0x00, 0x00, 0x00, 0x01, 0x65, 0x02],
+        )),
+    };
+    let pdu = wire_to_surface(
+        Codec1Type::Avc444,
+        exclusive(0, 0, 64, 64),
+        encode_vec(&stream).expect("encode AVC444"),
+    );
+
+    client
+        .process(0, &encode_for_process(&pdu))
+        .expect("both views are handed over");
+
+    assert_eq!(
+        *presented.lock().unwrap(),
+        [
+            (1, vec![0x00, 0x00, 0x00, 0x01, 0x65, 0x01], main_regions),
+            (1, vec![0x00, 0x00, 0x00, 0x01, 0x65, 0x02], Vec::new()),
+        ]
+    );
+}
+
+#[test]
+fn a_presenting_decoder_decodes_a_chroma_only_avc444_update_without_showing_it() {
+    let (mut client, presented) = presenting_client();
+    let stream = Avc444BitmapStream {
+        encoding: Encoding::CHROMA,
+        stream1: avc420_stream(vec![exclusive(0, 0, 64, 64)], &[0x00, 0x00, 0x00, 0x01, 0x41]),
+        stream2: None,
+    };
+    let pdu = wire_to_surface(
+        Codec1Type::Avc444v2,
+        exclusive(0, 0, 64, 64),
+        encode_vec(&stream).expect("encode AVC444"),
+    );
+
+    client
+        .process(0, &encode_for_process(&pdu))
+        .expect("the auxiliary view is handed over");
+
+    assert_eq!(
+        *presented.lock().unwrap(),
+        [(1, vec![0x00, 0x00, 0x00, 0x01, 0x41], Vec::new())]
+    );
+}
+
