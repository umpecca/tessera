+++ b/crates/ironrdp-headless/src/wire.rs
@@ -5,6 +5,7 @@
 
 use ironrdp::input::{MouseButton, MousePosition, Operation, Scancode, WheelRotations};
 use ironrdp::pdu::geometry::{ExclusiveRectangle, InclusiveRectangle, Rectangle as _};
+use ironrdp_egfx::decode::{Avc444Layout, PresentedView};
 
 /// Bytes from the server.
 pub const TAG_SERVER_BYTES: u8 = 0;
@@ -232,10 +233,13 @@ pub fn parse_input(payload: &[u8]) -> Result<Vec<Input>, String> {
     Ok(inputs)
 }
 
-/// `[surface u16][region count u16][x, y, width, height u16 each][Annex B data]`.
-pub fn h264_payload(surface_id: u16, regions: &[ExclusiveRectangle], data: &[u8]) -> Vec<u8> {
-    let mut payload = Vec::with_capacity(4 + regions.len() * 8 + data.len());
+/// `[surface u16][view u8][region count u16][x, y, width, height u16 each][Annex B data]`, where
+/// `view` is 0 for AVC420, 1 for an AVC444 main view and 2 for an AVC444 auxiliary view, plus 4
+/// for the AVC444v2 layout and 8 when the auxiliary view of the same update follows a main view.
+pub fn h264_payload(surface_id: u16, view: PresentedView, regions: &[ExclusiveRectangle], data: &[u8]) -> Vec<u8> {
+    let mut payload = Vec::with_capacity(5 + regions.len() * 8 + data.len());
     payload.extend_from_slice(&surface_id.to_le_bytes());
+    payload.push(view_code(view));
     payload.extend_from_slice(&u16::try_from(regions.len()).unwrap_or(u16::MAX).to_le_bytes());
     for region in regions.iter().take(usize::from(u16::MAX)) {
         for value in [
@@ -251,6 +255,18 @@ pub fn h264_payload(surface_id: u16, regions: &[ExclusiveRectangle], data: &[u8]
     payload
 }
 
+fn view_code(view: PresentedView) -> u8 {
+    let layout = |layout| if layout == Avc444Layout::V2 { 4 } else { 0 };
+    match view {
+        PresentedView::Avc420 => 0,
+        PresentedView::Avc444Main {
+            layout: main_layout,
+            auxiliary_follows,
+        } => 1 | layout(main_layout) | if auxiliary_follows { 8 } else { 0 },
+        PresentedView::Avc444Auxiliary { layout: aux_layout } => 2 | layout(aux_layout),
+    }
+}
+
 /// `[x u16][y u16][width u16][height u16][RGBA rows]` for `region` of an RGBA image `image_width`
 /// pixels wide, or `None` if the region doesn't fit in `image`.
 pub fn image_payload(image: &[u8], image_width: u16, region: &InclusiveRectangle) -> Option<Vec<u8>> {
@@ -408,11 +424,29 @@ mod tests {
             bottom: 8,
         }];
         assert_eq!(
-            h264_payload(7, &regions, &[0, 0, 0, 1, 0x65]),
-            [7, 0, 1, 0, 2, 0, 3, 0, 10, 0, 5, 0, 0, 0, 0, 1, 0x65]
+            h264_payload(7, PresentedView::Avc420, &regions, &[0, 0, 0, 1, 0x65]),
+            [7, 0, 0, 1, 0, 2, 0, 3, 0, 10, 0, 5, 0, 0, 0, 0, 1, 0x65]
         );
     }
 
+    #[test]
+    fn encodes_avc444_views() {
+        let main = PresentedView::Avc444Main {
+            layout: Avc444Layout::V2,
+            auxiliary_follows: true,
+        };
+        assert_eq!(h264_payload(1, main, &[], &[])[2], 1 | 4 | 8);
+        let lone_main = PresentedView::Avc444Main {
+            layout: Avc444Layout::V1,
+            auxiliary_follows: false,
+        };
+        assert_eq!(h264_payload(1, lone_main, &[], &[])[2], 1);
+        let auxiliary = PresentedView::Avc444Auxiliary {
+            layout: Avc444Layout::V1,
+        };
+        assert_eq!(h264_payload(1, auxiliary, &[], &[])[2], 2);
+    }
+
