From 4a04e6401484f901b166b5f246bdc31876fa7041 Mon Sep 17 00:00:00 2001
From: jaxdad <atxhxag@gmail.com>
Date: Wed, 28 Oct 2026 09:58:00 -0500
Subject: [PATCH 08/11] feat(headless): carry the view of each H.264 picture to
 the host

The H.264 event payload gains a view byte after the surface ID, coded as
the web client's `h264_frame_callback` codes it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/ironrdp-headless/src/lib.rs  |  6 ++--
 crates/ironrdp-headless/src/wire.rs | 44 +++++++++++++++++++++++++----
 2 files changed, 42 insertions(+), 8 deletions(-)

diff --git a/crates/ironrdp-headless/src/lib.rs b/crates/ironrdp-headless/src/lib.rs
index e05b53ed..220ceb1b 100644
--- a/crates/ironrdp-headless/src/lib.rs
+++ b/crates/ironrdp-headless/src/lib.rs
@@ -51,7 +51,7 @@ use ironrdp::session::{ActiveStage, ActiveStageBuilder, ActiveStageOutput};
 use ironrdp_blocking::Framed;
 use ironrdp_core::WriteBuf;
 use ironrdp_egfx::client::{GraphicsPipelineClient, GraphicsPipelineHandler};
-use ironrdp_egfx::decode::{DecodedFrame, DecoderError, DecoderResult, H264Decoder};
+use ironrdp_egfx::decode::{DecodedFrame, DecoderError, DecoderResult, H264Decoder, PresentedView};
 
 use self::wire::{Config, End, Input, Message};
 
@@ -206,8 +206,8 @@ impl H264Decoder for HostPresentedH264 {
         true
     }
 
-    fn present(&mut self, surface_id: u16, data: &[u8], regions: &[ExclusiveRectangle]) {
-        emit(Event::H264, &wire::h264_payload(surface_id, regions, data));
+    fn present(&mut self, surface_id: u16, view: PresentedView, data: &[u8], regions: &[ExclusiveRectangle]) {
+        emit(Event::H264, &wire::h264_payload(surface_id, view, regions, data));
     }
 }
 
