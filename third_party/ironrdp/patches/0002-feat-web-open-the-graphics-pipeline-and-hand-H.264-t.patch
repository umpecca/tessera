+    /// Matches the backing store to the decoded image. A graphics pipeline `ResetGraphics` resizes
+    /// the image without the Deactivation-Reactivation Sequence that calls [`Self::resize`].
+    pub(crate) fn fit(&mut self, width: u16, height: u16) {
+        let (width, height) = (u32::from(width), u32::from(height));
+        if self.canvas.width() != width || self.canvas.height() != height {
+            self.canvas.set_width(width);
+            self.canvas.set_height(height);
+        }
+    }
