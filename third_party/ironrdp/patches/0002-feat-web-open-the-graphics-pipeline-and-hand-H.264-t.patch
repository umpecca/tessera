+/// An H.264 picture for JavaScript to decode and draw: an Annex B access unit and the surface
+/// regions it updates, as `[x, y, width, height]` quadruples. No regions means decode only.
+pub(crate) struct H264Frame {
+    surface_id: u16,
+    data: Vec<u8>,
+    regions: Vec<u16>,
+}
+
+/// An H.264 decoder that leaves decoding and drawing to JavaScript: each picture goes to the
+/// session, which hands it to the `h264_frame_callback`.
+struct JsPresentedH264 {
+    frames: mpsc::UnboundedSender<H264Frame>,
+}
+
+impl H264Decoder for JsPresentedH264 {
+    fn decode(&mut self, _data: &[u8]) -> DecoderResult<DecodedFrame> {
+        // Unreachable: a decoder that presents frames is handed them through `present`.
+        Err(DecoderError::msg("H.264 is decoded in JavaScript"))
+    }
+
+    fn presents_frames(&self) -> bool {
+        true
+    }
+
+    fn present(&mut self, surface_id: u16, data: &[u8], regions: &[ironrdp::pdu::geometry::ExclusiveRectangle]) {
+        let regions = regions
+            .iter()
+            .flat_map(|region| {
+                [
+                    region.left,
+                    region.top,
+                    region.right.saturating_sub(region.left),
+                    region.bottom.saturating_sub(region.top),
+                ]
+            })
+            .collect();
+        let frame = H264Frame {
+            surface_id,
+            data: data.to_vec(),
+            regions,
+        };
+        if self.frames.unbounded_send(frame).is_err() {
+            warn!("H.264 frame dropped: the session is no longer reading them");
+        }
+    }
+}
